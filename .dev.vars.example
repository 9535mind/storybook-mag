# Copy to .dev.vars and fill real values. Do not commit .dev.vars.

# Admin emergency PIN — 비밀번호 분실 시 「비밀번호 다시 만들기」에도 사용
# (signup invite fallback if SIGNUP_INVITE_CODE is empty)
ADMIN_PIN=change_me_now

# 개인 사용 잠금 (기본 ON). admin 계정만 로그인·API 가능, 회원가입 차단.
# 공개할 때: SOLO_ADMIN_ONLY=0
SOLO_ADMIN_ONLY=1

# Preferred separate invite code for signup (SOLO_ADMIN_ONLY=0 일 때만 사용)
SIGNUP_INVITE_CODE=change_invite_code

# 글쓰기 desk 주 엔진 — Anthropic Claude (에세이·동화·관찰)
# Cloudflare: npx wrangler pages secret put ANTHROPIC_API_KEY --project-name=storymag
ANTHROPIC_API_KEY=sk-ant-...
# 기본: claude-sonnet-5 (필요 시 claude-opus-4-8 등)
ANTHROPIC_MODEL=claude-sonnet-5

# Primary image engine — Replicate Juggernaut XL Lightning
REPLICATE_API_TOKEN=your_replicate_token_here
REPLICATE_MODEL_OWNER=sdxl-based
REPLICATE_MODEL_NAME=juggernaut-xl-lightning
# REPLICATE_MODEL_VERSION=<optional version id>

# 정밀 모드 전용 모델(선택) — Lightning이 아닌, 스텝을 늘릴수록 실제로 좋아지는 일반 SDXL.
# 비워두면 공개 기본값(stability-ai/sdxl)을 사용한다. 생성 시간이 늘어남에 유의.
# REPLICATE_PRECISION_MODEL_OWNER=stability-ai
# REPLICATE_PRECISION_MODEL_NAME=sdxl
# REPLICATE_PRECISION_MODEL_VERSION=<optional version id>

# Fallback / wildlife-priority — fal.ai Flux.2 Pro
FAL_KEY=your_fal_key_here
FAL_MODEL_ID=fal-ai/flux-2-pro

# I2V shorts — Replicate Wan2.2 (reuses REPLICATE_API_TOKEN)
REPLICATE_VIDEO_MODEL_OWNER=wan-video
REPLICATE_VIDEO_MODEL_NAME=wan-2.2-i2v-fast
# REPLICATE_VIDEO_MODEL_VERSION=<optional version id>
